# --- App ---
APP_NAME=SOC-Lite
ENVIRONMENT=development
JWT_SECRET=cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://soclite:soclite@localhost:5432/soclite

# --- Webhook (n8n -> API) ---
WEBHOOK_TOKEN=soclite-webhook-token

# --- LLM local (Ollama) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=60
TRIAGE_FALLBACK_ENABLED=true

# --- Enrichment (sin API key => modo simulado determinista) ---
ENRICHMENT_MOCK=true
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
