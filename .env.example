# --- App ---
APP_NAME=SOC-Lite
ENVIRONMENT=development
JWT_SECRET=cambiar-en-produccion
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://soclite:soclite@localhost:5432/soclite

# --- Webhook (n8n -> API) ---
WEBHOOK_TOKEN=soclite-webhook-token

# --- LLM local (Ollama) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=60
TRIAGE_FALLBACK_ENABLED=true

# --- Enrichment (sin API key => modo simulado determinista) ---
ENRICHMENT_MOCK=true
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- n8n (workflow n8n/workflows/soc_lite_triage.json) ---
# Usuario de servicio que crea el seed (rol analyst). Sin password no se crea.
N8N_SERVICE_USER=n8n
N8N_SERVICE_PASSWORD=
# Clave de cifrado de credenciales de n8n. Generar con: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678
SLACK_CHANNEL=#soc-alertas
OSTICKET_URL=http://osticket/api/tickets.json
OSTICKET_API_KEY=
