{
  "id": "SocLiteTriage001",
  "name": "SOC-Lite - Triaje automatico de alertas Wazuh/OPNsense",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "soc-alert",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "1f0c1a2e-3b4d-4c5e-8f60-7a8b9c0d1e2f",
      "name": "1. Webhook alertas Wazuh/OPNsense",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [-1200, 0],
      "webhookId": "1f0c1a2e-3b4d-4c5e-8f60-7a8b9c0d1e2f"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json || {};\nconst rule = item.rule || {};\nconst data = item.data || {};\nconst severityMap = { alta: 'alta', media: 'media', baja: 'baja', high: 'alta', medium: 'media', low: 'baja', critical: 'alta' };\nconst rawSeverity = item.severity ?? item.rule_level ?? rule.level ?? item.priority ?? '';\nlet severity = typeof rawSeverity === 'string' ? rawSeverity.toLowerCase().trim() : '';\nif (severityMap[severity]) {\n  severity = severityMap[severity];\n} else {\n  const level = Number(rawSeverity);\n  severity = Number.isFinite(level) ? (level >= 10 ? 'alta' : level >= 5 ? 'media' : 'baja') : '';\n}\nconst srcIp = item.src_ip || item.srcip || item.source_ip || data.srcip || data.src_ip || null;\nconst dstIp = item.dst_ip || item.dstip || item.destination_ip || data.dstip || data.dst_ip || null;\nconst title = item.title || item.message || rule.description || 'Alerta sin titulo';\nconst source = String(item.source || (item.rule ? 'wazuh' : 'opnsense')).toLowerCase();\nreturn {\n  json: {\n    source,\n    severity,\n    title: String(title).slice(0, 255),\n    rule_id: item.rule_id ? String(item.rule_id) : rule.id ? String(rule.id) : null,\n    description: item.description || item.full_log || null,\n    src_ip: srcIp,\n    dst_ip: dstIp,\n    raw_payload: item,\n    is_valid: ['alta', 'media', 'baja'].includes(severity) && Boolean(title) && Boolean(srcIp || dstIp),\n  },\n};"
      },
      "id": "2a1b2c3d-4e5f-4a6b-9c7d-8e9f0a1b2c3d",
      "name": "2. Normalizar alerta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-980, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-valida",
              "leftValue": "={{ $json.is_valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3b2c3d4e-5f6a-4b7c-8d9e-0f1a2b3c4d5e",
      "name": "3. IF alerta valida",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.4,
      "position": [-760, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SOC_API_URL }}/api/v1/alerts/webhook",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Token",
              "value": "={{ $env.SOC_WEBHOOK_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: $json.source, severity: $json.severity, title: $json.title, rule_id: $json.rule_id, description: $json.description, src_ip: $json.src_ip, dst_ip: $json.dst_ip, raw_payload: $json.raw_payload }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "4c3d4e5f-6a7b-4c8d-9e0f-1a2b3c4d5e6f",
      "name": "4. HTTP ingesta API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [-540, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SOC_API_URL }}/api/v1/auth/login/json",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ username: $env.SOC_API_USER, password: $env.SOC_API_PASSWORD }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "5d4e5f6a-7b8c-4d9e-8f1a-2b3c4d5e6f70",
      "name": "5. HTTP login servicio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [-320, 0],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SOC_API_URL }}/api/v1/triage/{{ $('4. HTTP ingesta API').item.json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('5. HTTP login servicio').item.json.access_token }}"
            }
          ]
        },
        "options": {
          "timeout": 180000
        }
      },
      "id": "6e5f6a7b-8c9d-4e0f-9a2b-3c4d5e6f7081",
      "name": "6. HTTP ejecuta triaje",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [-100, 0],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "rule-alta",
                    "leftValue": "={{ $json.predicted_severity }}",
                    "rightValue": "alta",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "alta"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "rule-media",
                    "leftValue": "={{ $json.predicted_severity }}",
                    "rightValue": "media",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "media"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "baja"
        }
      },
      "id": "7f6a7b8c-9d0e-4f1a-8b3c-4d5e6f708192",
      "name": "7. Switch severidad",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.5,
      "position": [120, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $env.SLACK_CHANNEL }}"
        },
        "messageType": "text",
        "text": "=:rotating_light: *ALERTA ALTA TRIADA* (SOC-Lite)\n*Titulo:* {{ $('2. Normalizar alerta').item.json.title }}\n*Veredicto:* {{ $json.llm_verdict }} (confianza {{ $json.confidence }})\n*Resumen:* {{ $json.summary }}\n*Acciones:* {{ ($json.recommended_actions || []).join(' | ') }}",
        "otherOptions": {}
      },
      "id": "8a7b8c9d-0e1f-4a2b-9c4d-5e6f708192a3",
      "name": "8. Slack notifica alta",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [340, -240],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OSTICKET_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.OSTICKET_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ autorespond: 0, alert_only: 1, ticket: { email: 'soc@soclite.local', name: 'SOC-Lite (automatico)', subject: '[SOC-Lite] Alerta ' + $('6. HTTP ejecuta triaje').item.json.predicted_severity + ': ' + $('2. Normalizar alerta').item.json.title, message: ($('6. HTTP ejecuta triaje').item.json.summary || '') + '\\n\\nAcciones: ' + (($('6. HTTP ejecuta triaje').item.json.recommended_actions || []).join('; ')), ip: ($('2. Normalizar alerta').item.json.src_ip || '') } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "9b8c9d0e-1f2a-4b3c-8d5e-6f708192a3b4",
      "name": "9. HTTP ticket osTicket (alta)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [560, -240],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
