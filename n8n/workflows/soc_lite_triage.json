      "id": "ac9d0e1f-2a3b-4c4d-9e6f-708192a3b4c5",
      "name": "10. HTTP ticket osTicket (media)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [340, 0],
      "retryOnFail": true,
      "maxTries": 2,
