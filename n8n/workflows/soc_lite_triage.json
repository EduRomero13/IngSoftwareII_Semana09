    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO triage_results (alert_id, llm_verdict, predicted_severity, confidence, summary, recommended_actions, model_name, engine, tokens_used, latency_ms, created_at)\nSELECT\n  {{ $json.alert_id || $('4. HTTP llama microservicio LangChain (triaje)').item.json.alert_id || 0 }},\n  {{ JSON.stringify($json.llm_verdict || 'sospechoso') }},\n  {{ JSON.stringify($json.predicted_severity || 'media') }},\n  {{ Number($json.confidence || 0) }},\n  {{ JSON.stringify($json.summary || '') }},\n  {{ JSON.stringify(JSON.stringify($json.recommended_actions || [])) }}::jsonb,\n  {{ JSON.stringify($json.model_name || null) }},\n  {{ JSON.stringify($json.engine || 'llm') }},\n  {{ $json.tokens_used || 'NULL' }},\n  {{ $json.latency_ms || 'NULL' }},\n  NOW()\nWHERE NOT EXISTS (SELECT 1 FROM triage_results WHERE alert_id = {{ $json.alert_id || $('4. HTTP llama microservicio LangChain (triaje)').item.json.alert_id || 0 }})\nON CONFLICT DO NOTHING;\nUPDATE alerts SET status = 'triaged' WHERE id = {{ $json.alert_id || $('4. HTTP llama microservicio LangChain (triaje)').item.json.alert_id || 0 }};",
        "options": {}
