    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-severidad",
              "leftValue": "={{ $json.severity }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEquals",
                "singleValue": true
              }
            },
            {
              "id": "cond-duplicado",
              "leftValue": "={{ $json.is_duplicate }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "notEquals",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-02-if",
      "name": "2. IF filtra duplicados y severidad < media",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-960, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ins AS (\n  INSERT INTO alerts (source, rule_id, severity, title, description, src_ip, dst_ip, raw_payload, dedup_hash, status, created_at)\n  VALUES (\n    {{ JSON.stringify($json.source || 'wazuh') }},\n    {{ JSON.stringify($json.rule_id || $json.rule?.id || null) }},\n    {{ JSON.stringify($json.severity || 'media') }},\n    {{ JSON.stringify($json.title || $json.rule?.description || 'Alerta sin titulo') }},\n    {{ JSON.stringify($json.description || null) }},\n    {{ JSON.stringify($json.src_ip || $json.data?.src_ip || null) }},\n    {{ JSON.stringify($json.dst_ip || $json.data?.dst_ip || null) }},\n    {{ JSON.stringify(JSON.stringify($json)) }}::jsonb,\n    md5({{ JSON.stringify(JSON.stringify($json)) }}),\n    'pending',\n    NOW()\n  )\n  ON CONFLICT (dedup_hash) DO NOTHING\n  RETURNING id\n)\nSELECT COALESCE(\n  (SELECT id FROM ins),\n  (SELECT id FROM alerts WHERE dedup_hash = md5({{ JSON.stringify(JSON.stringify($json)) }}))\n) AS alert_id;",
        "options": {}
      },
      "id": "node-03-postgres-alerta",
      "name": "3. PostgreSQL persiste alerta (pending)",
